#!/usr/bin/env python3
"""Run GameBench from any directory."""
import sys
from pathlib import Path
sys.dont_write_bytecode = True
if sys.version_info < (3, 12):
    sys.exit('GameBench requires Python 3.12 or newer.')
from gamebench.run import main
if __name__ == '__main__':
    try:
        sys.exit(main())
    except (FileNotFoundError, OSError, ValueError, RuntimeError) as e:
        sys.exit(f'GameBench: {e}')
